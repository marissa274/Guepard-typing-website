{
  "name": "guepard",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev --webpack -p 5173",
    "build": "next build --webpack",
    "start": "next start -p ${PORT:-5173} -H 0.0.0.0",
    "preview": "next start -p 5173",
    "db:up": "docker compose up -d db",
    "db:stop": "docker compose stop db",
    "db:migrate": "node --env-file=.env.local scripts/migrate-rooms-to-postgres.ts",
    "test": "jest --config jest.config.json --runInBand",
    "test:e2e": "playwright test",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@babel/preset-env": "^7.29.7",
    "@babel/preset-react": "^7.29.7",
    "@babel/preset-typescript": "^7.29.7",
    "@playwright/test": "^1.63.0",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^26.6.4",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "babel-jest": "^30.5.2",
    "jest": "^30.5.2",
    "jest-environment-jsdom": "^30.5.2",
    "jsdom": "^29.1.1",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "next": "^16.3.8",
    "pg": "^8.23.1",
    "postcss": "^8.5.28",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tailwindcss": "^4.3.3"
  }
}
