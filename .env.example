# Démarrer PostgreSQL local avec : docker compose up -d db
# À renseigner dans .env.local. Le mot de passe doit correspondre à GUEPARD_DB_PASSWORD de Compose.
DATABASE_URL=postgresql://guepard:guepard_dev_only@127.0.0.1:5433/guepard

# URL publique du service web en production (aucune adresse localhost sur Railway).
# APP_URL=https://guepard-typing-website-production.up.railway.app
# RAILWAY_PUBLIC_DOMAIN, fourni par Railway, est aussi reconnu automatiquement.
