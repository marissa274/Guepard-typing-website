# PostgreSQL local : docker compose up -d db
# Mot de passe de développement public, à changer pour tout autre environnement.
DATABASE_URL=postgresql://guepard:guepard_dev_only@127.0.0.1:5433/guepard

# Port HTTP de `npm start` (5173 par défaut). Railway et la plupart des hébergeurs le fournissent.
# PORT=5173

# URL publique canonique sans chemin. Obligatoire pour OAuth en production.
# APP_URL=https://votre-site.example
# RAILWAY_PUBLIC_DOMAIN est fourni automatiquement par Railway si utilisé.

# Secret privé stable pour signer l'identité invitée et les empreintes serveur.
# Générer une valeur locale : openssl rand -hex 32 ; ne jamais la commiter.
AUTH_SECRET=

# OAuth facultatif en développement : créer vos propres applications fournisseurs.
# GitHub callback : <APP_URL>/api/auth/github/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Discord callback : <APP_URL>/api/auth/discord/callback
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# Seed de démonstration : obligatoire si NODE_ENV=production.
# En développement uniquement, défaut public documenté : GuepardDemo2026!
# GUEPARD_DEMO_PASSWORD=

# Docker Compose : optionnel, doit correspondre à DATABASE_URL.
# GUEPARD_DB_PASSWORD=guepard_dev_only
# GUEPARD_DATA_DIR : dossier du fallback JSON local à instance unique, hors PostgreSQL.
# GUEPARD_DATA_DIR=.data
# PLAYWRIGHT_CHROME_PATH : chemin du navigateur installé pour les tests locaux.
# GUEPARD_TEST_PORT : port d'un serveur de production isolé pour les E2E.

# Adresse IP client (limite de 10 codes/min par IP, liaison des invitations, expulsions).
# Sans proxy, X-Forwarded-For peut être écrit par le client (Next.js ne le remplit que s'il manque) :
# il n'est lu que si l'une des deux variables ci-dessous est définie. Sinon, tous les visiteurs partagent
# une seule empreinte (correct en local ; avertissement au démarrage en production).
# Railway : GUEPARD_CLIENT_IP_HEADER=X-Real-IP (repli possible : GUEPARD_TRUST_PROXY=1).
# Voir docs/deploiement-railway.md.
# GUEPARD_CLIENT_IP_HEADER : en-tête que la plateforme écrase toujours (ex. X-Real-IP, CF-Connecting-IP).
# Ne le définir que si le proxy remplace cet en-tête ; sinon un client pourrait le falsifier.
# GUEPARD_CLIENT_IP_HEADER=X-Real-IP
# GUEPARD_TRUST_PROXY : nombre (1 à 10) de proxys qui ajoutent une entrée à X-Forwarded-For.
# GUEPARD_TRUST_PROXY=1
